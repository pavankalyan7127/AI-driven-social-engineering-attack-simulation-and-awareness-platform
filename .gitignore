*/node_modules/
jspm_packages/

# Production build outputs
dist/
*/dist/
build/
*/build/
dist-ssr/
out/

# Python cache & virtual environments
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
ENV/
*.egg-info/
.pytest_cache/

# Environment files & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & local data storage
data/
dump/
*.sqlite
*.sqlite3
mongo-data/

# Testing & Coverage
coverage/
.nyc_output/
.coverage
.vitest-cache/

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
